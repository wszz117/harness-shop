# shop-v2 环境变量（复制为 .env 使用）
NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/shop-v2
JWT_SECRET=change-me-in-production
# 汇率来源优先级：FX_UPSTREAM_URL（上游接口，兼容 {rate} 或 {rates:{CNY}}）> FX_FIXED_RATE > 内置演示汇率 7.25
# 两项都留空即可开箱运行
FX_UPSTREAM_URL=
FX_FIXED_RATE=
FX_REFRESH_INTERVAL_MS=3600000
PAGINATION_LIMIT=8
