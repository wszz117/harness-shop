{
  "name": "shop-v2",
  "version": "2.0.0",
  "description": "MERN 电商 + Harness Engineering 多 Agent 研发流程工程化系统",
  "type": "module",
  "main": "backend/server.js",
  "scripts": {
    "server": "nodemon backend/server.js",
    "client": "npm start --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "start": "node backend/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:frontend": "vitest run -c vitest.frontend.config.js",
    "test:e2e": "playwright test -c e2e/playwright.config.js",
    "data:import": "node backend/seeder.js",
    "data:destroy": "node backend/seeder.js -d",
    "verify": "bash .harness/scripts/verify.sh",
    "check:harness": "bash .harness/scripts/check-harness.sh"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "concurrently": "^8.2.2",
    "jsdom": "^29.1.1",
    "mongodb-memory-server": "^9.2.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0",
    "vitest": "^1.6.0"
  }
}
