        FE["frontend/<br/>React 18 + Vite<br/>Redux Toolkit + RTK Query"]
        BE["backend/<br/>Express + Mongoose ESM<br/>routes→controllers→services→models"]
        DB[("MongoDB")]
        E2E["e2e/<br/>Playwright 取证"]
        MCPS["mcp-server/<br/>看板/状态/verify"]
    end
    HUMAN -->|"发起任务 / 审批"| CMD
    CMD -->|"PM 调度角色接力"| AGENTS
    HOOKS -->|"触发硬门禁"| SCRIPTS
    AGENTS -->|"Dev 编写代码（TDD）"| FE
    AGENTS -->|"Dev 编写代码（TDD）"| BE
    SCRIPTS -->|"退出码验证：单测 / E2E / 规范扫描"| APP
    FE -->|"RTK Query /api/*"| BE
    BE -->|"Mongoose ODM"| DB
    E2E -.->|"浏览器取证"| FE
    DELIV -->|"归档：Spec / Memory Merge"| KB
    style HUMAN fill:#fff5f5,stroke:#c53030,stroke-width:2px
