flowchart TB
    HUMAN["👤 人工工程师<br/>需求提出 · 两次人工审批"]
    subgraph CURSOR["AI 代理协作层 · .cursor/（Cursor IDE 扩展点）"]
        direction LR
        CMD["commands/<br/>三命令工作流<br/>propose · apply · archive"]
        RULES["rules/<br/>3 个常驻软约束"]
        SKILLS["skills/<br/>5 个 SOP 手册"]
        HOOKS["hooks/<br/>3 事件旁路验证<br/>（进程外 Python）"]
        MCP["mcp.json<br/>本地 MCP 工具"]
    end
    subgraph HARNESS["Harness 资产层 · .harness/（单一真相源）"]
        direction LR
        AGENTS["agents/<br/>7 角色契约<br/>PM·BA·SA·RR·Dev·CR·TE"]
        KB["三库知识工程<br/>specs / codebase-guide / memory"]
        TPL["templates/<br/>9 个填表式模板"]
        SCRIPTS["scripts/<br/>13 个硬门禁脚本<br/>verify 19 项 · 体检 90+ 项"]
        DELIV["deliverables/<br/>任务交付与归档<br/>（证据链）"]
        WF["workflow/<br/>8 阶段状态机"]
    end
    subgraph APP["业务应用层 · MERN 电商演示域"]
